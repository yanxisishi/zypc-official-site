---
interface Props {
  id: string;
  title: string;
  description: string;
  category: string;
  tags: string[];
  author: string;
  publishedAt: Date;
  sample?: boolean;
  featured?: boolean;
}

const {
  id,
  title,
  description,
  category,
  tags,
  author,
  publishedAt,
  sample = false,
  featured = false,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(publishedAt);
---

<article class:list={['article-card', { 'article-card--featured': featured }]} data-article-card data-title={title} data-description={description} data-category={category} data-tags={tags.join(' ')}>
  <a href={`/articles/${id}/`}>
    <div class="article-card__meta">
      <span>{category}</span>
      <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
    </div>
    <h3>{title}</h3>
    <p>{description}</p>
    <div class="article-card__footer">
      <span>{sample ? '模板示例' : author}</span>
      <span class="article-card__arrow" aria-hidden="true">→</span>
    </div>
  </a>
</article>

<style>
  .article-card {
    min-height: 15rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .article-card:hover {
    border-color: rgba(64, 157, 216, 0.48);
    box-shadow: var(--shadow-soft);
    transform: translateY(-4px);
  }

  a {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(1.35rem, 3vw, 2rem);
    color: inherit;
    text-decoration: none;
  }

  .article-card__meta,
  .article-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0.08em;
  }

  .article-card__meta span {
    color: var(--blue-700);
    font-weight: 700;
  }

  h3 {
    margin: 2.2rem 0 0.8rem;
    color: var(--ink);
    font-size: var(--text-card);
    font-weight: 660;
    letter-spacing: -0.018em;
    line-height: 1.35;
  }

  p {
    margin: 0;
    color: var(--muted);
    line-height: 1.8;
  }

  .article-card__footer {
    margin-top: auto;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .article-card__arrow {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 50%;
    background: var(--blue-50);
    color: var(--blue-700);
    font-size: 1rem;
    transition: color 180ms ease, background 180ms ease;
  }

  .article-card:hover .article-card__arrow {
    background: var(--blue);
    color: var(--action-text);
  }

  .article-card--featured {
    background: var(--deep);
  }

  .article-card--featured h3 {
    color: var(--on-deep);
  }

  .article-card--featured p,
  .article-card--featured .article-card__meta,
  .article-card--featured .article-card__footer {
    color: var(--on-deep-muted);
  }

  .article-card--featured .article-card__meta span {
    color: var(--blue-300);
  }

  .article-card--featured .article-card__footer {
    border-color: rgba(255, 255, 255, 0.13);
  }
</style>
