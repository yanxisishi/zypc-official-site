---
interface Props {
  id: string;
  title: string;
  description: string;
  tags: string[];
  publishedAt: Date;
  wordCount: number;
  cover?: string;
}

const {
  id,
  title,
  description,
  tags,
  publishedAt,
  wordCount,
  cover,
} = Astro.props;

const visibleTags = tags.slice(0, 3);
const remainingTagCount = Math.max(0, tags.length - visibleTags.length);
const formattedDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(publishedAt);
---

<article class:list={['article-card', { 'article-card--with-cover': cover }]}>
  <a class="article-card__link" href={`/articles/${id}/`}>
    {
      cover && (
        <div class="article-card__media" aria-hidden="true">
          <img src={cover} alt="" loading="lazy" decoding="async" />
        </div>
      )
    }
    <div class="article-card__content">
      <h2>{title}</h2>
      <p>{description}</p>
      <div class="article-card__meta">
        <time datetime={publishedAt.toISOString()}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3.5" y="5.5" width="17" height="15" rx="2"></rect>
            <path d="M8 3.5v4M16 3.5v4M3.5 10h17"></path>
          </svg>
          {formattedDate}
        </time>
        {
          visibleTags.length > 0 && (
            <ul class="article-card__tags" aria-label="文章标签">
              {visibleTags.map((tag) => <li>#{tag}</li>)}
              {remainingTagCount > 0 && (
                <li class="article-card__tag-overflow" aria-label={`另有 ${remainingTagCount} 个标签`}>
                  +{remainingTagCount}
                </li>
              )}
            </ul>
          )
        }
        <span class="article-card__word-count" aria-label={`文章字数 ${wordCount} 字`}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 5h14M5 9h14M5 13h9M5 17h7"></path>
          </svg>
          <span aria-hidden="true">{wordCount} 字</span>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .article-card {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 0.95rem;
    background: var(--surface-card);
    box-shadow: 0 0.25rem 0.9rem rgba(12, 49, 83, 0.045);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .article-card:hover,
  .article-card:focus-within {
    border-color: color-mix(in srgb, var(--blue) 48%, var(--line));
    box-shadow: 0 0.7rem 1.7rem color-mix(in srgb, var(--blue) 10%, transparent);
    transform: translateY(-0.12rem);
  }

  .article-card__link {
    display: grid;
    min-height: 7.35rem;
    color: inherit;
    text-decoration: none;
  }

  .article-card__link:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: -3px;
  }

  .article-card--with-cover .article-card__link {
    grid-template-columns: minmax(0, 64%) minmax(15rem, 36%);
  }

  .article-card__content {
    z-index: 1;
    display: grid;
    min-width: 0;
    align-content: center;
    gap: 0.42rem;
    padding: 1.15rem 1.35rem;
  }

  .article-card h2 {
    overflow: hidden;
    color: var(--ink);
    font-size: 1.12rem;
    font-weight: 660;
    letter-spacing: -0.018em;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .article-card__content > p {
    overflow: hidden;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.58;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .article-card__meta {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1rem;
    margin-top: 0.1rem;
    color: var(--muted);
    font-size: var(--text-meta);
  }

  .article-card__meta time,
  .article-card__word-count {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.32rem;
  }

  .article-card__meta time {
    color: var(--red-soft-ink);
  }

  .article-card__word-count {
    color: var(--purple-soft-ink);
  }

  .article-card__meta svg {
    width: 0.92rem;
    height: 0.92rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .article-card__tags {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    gap: 0.25rem 0.65rem;
    margin: 0;
    padding: 0;
    color: var(--blue);
    font-weight: 500;
    font-synthesis: none;
    letter-spacing: 0.008em;
    list-style: none;
  }

  .article-card__tag-overflow {
    color: var(--muted);
    font-weight: 500;
  }

  .article-card__media {
    position: relative;
    overflow: hidden;
    grid-column: 2;
    grid-row: 1;
    min-height: 7.35rem;
  }

  .article-card__media::before {
    position: absolute;
    z-index: 1;
    inset: 0 auto 0 0;
    width: 3rem;
    background: linear-gradient(90deg, var(--surface-card), transparent);
    content: '';
  }

  .article-card__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 240ms ease;
  }

  .article-card:hover .article-card__media img,
  .article-card:focus-within .article-card__media img {
    transform: scale(1.018);
  }

  @media (max-width: 650px) {
    .article-card,
    .article-card__link {
      min-height: 0;
    }

    .article-card--with-cover .article-card__link {
      grid-template-columns: 1fr;
    }

    .article-card__content {
      gap: 0.38rem;
      padding: 1rem 1.05rem;
    }

    .article-card h2 {
      font-size: 1.05rem;
      white-space: normal;
    }

    .article-card__content > p {
      display: -webkit-box;
      overflow: hidden;
      font-size: 0.84rem;
      white-space: normal;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    .article-card__meta {
      gap: 0.3rem 0.8rem;
    }

    .article-card__media {
      grid-column: 1;
      grid-row: 1;
      min-height: 0;
      aspect-ratio: 16 / 7;
    }

    .article-card__media::before {
      inset: auto 0 0;
      width: auto;
      height: 2.5rem;
      background: linear-gradient(180deg, transparent, var(--surface-card));
    }

    .article-card--with-cover .article-card__content {
      grid-row: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-card,
    .article-card__media img {
      transition: none;
    }
  }
</style>
