---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  description: string;
  meta?: string;
}

const { index, eyebrow, title, description, meta } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero__signal" aria-hidden="true"></div>
  <div class="shell page-hero__inner">
    <div class="page-hero__number" aria-hidden="true">{index}</div>
    <div class="page-hero__copy" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="page-hero__description">{description}</p>
      {meta && <p class="page-hero__meta">{meta}</p>}
    </div>
    <div class="page-hero__stamp" aria-hidden="true">
      <span>XUPT × ZYPC</span>
      <i></i>
      <span>34°09′N · 108°54′E</span>
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(6rem, 8vw, 7rem) 0 clamp(3rem, 5vw, 4.25rem);
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(circle at 86% 20%, rgba(91, 180, 235, 0.15), transparent 24rem),
      var(--paper);
  }

  .page-hero__signal {
    position: absolute;
    inset: auto 0 0;
    height: 52%;
    opacity: 0.48;
    background: url('/brand/brand-signal.svg') center bottom / cover no-repeat;
    pointer-events: none;
  }

  .page-hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(5rem, 0.45fr) minmax(0, 4fr) minmax(12rem, 1fr);
    align-items: end;
    gap: 1.5rem;
  }

  .page-hero__number {
    align-self: start;
    color: var(--orange);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 750;
    letter-spacing: 0.14em;
  }

  h1 {
    max-width: 62rem;
    margin: 0;
    color: var(--ink);
    font-size: var(--text-page);
    font-weight: 670;
    letter-spacing: var(--tracking-heading);
    line-height: 1.12;
  }

  .page-hero__description {
    max-width: 45rem;
    margin: 1.6rem 0 0;
    color: var(--muted);
    font-size: var(--text-body);
    line-height: 1.8;
  }

  .page-hero__meta {
    display: inline-flex;
    margin: 1.5rem 0 0;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-subtle);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0.08em;
  }

  .page-hero__stamp {
    justify-self: end;
    display: grid;
    gap: 0.65rem;
    width: 11rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0.11em;
    text-align: right;
  }

  .page-hero__stamp i {
    display: block;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--blue));
  }

  @media (max-width: 820px) {
    .page-hero__inner {
      grid-template-columns: 2.5rem 1fr;
    }

    .page-hero__stamp {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .page-hero {
      padding-top: 6rem;
    }

    .page-hero__inner {
      display: block;
    }

    .page-hero__number {
      margin-bottom: 1.25rem;
    }
  }
</style>
