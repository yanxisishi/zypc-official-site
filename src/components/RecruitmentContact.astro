---
import LogoMark from './LogoMark.astro';

interface Props {
  cohort?: string;
  qqGroup: string;
  wechatAccount: string;
  variant?: 'compact' | 'full';
}

const {
  cohort,
  qqGroup,
  wechatAccount,
  variant = 'compact',
} = Astro.props;
---

<div
  class:list={['recruitment-contact', `recruitment-contact--${variant}`]}
  data-recruitment-contact
>
  {
    variant === 'compact' ? (
      <div class="recruitment-contact__compact">
        <LogoMark size="small" />
        <strong class="recruitment-contact__compact-title">
          {cohort ? `${cohort} 纳新交流群` : '纳新交流群'}
        </strong>
        <button
          class="recruitment-contact__copy"
          type="button"
          aria-label={`复制 QQ 群号 ${qqGroup}`}
          data-copy-group={qqGroup}
        >
          <span class="recruitment-contact__number">{qqGroup}</span>
          <svg class="recruitment-contact__copy-icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="8" y="8" width="11" height="11" rx="2"></rect>
            <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
          </svg>
          <svg class="recruitment-contact__check-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m5 12 4 4L19 6"></path>
          </svg>
          <span class="sr-only" data-copy-label>复制群号</span>
        </button>
      </div>
    ) : (
      <dl class="recruitment-contact__list">
        <div>
          <dt>微信公众号</dt>
          <dd>
            <strong>{wechatAccount}</strong>
            <span>在微信内搜索并关注</span>
          </dd>
        </div>
        <div>
          <dt>纳新交流群</dt>
          <dd>
            <button
              class="recruitment-contact__group"
              type="button"
              aria-label={`复制 QQ 群号 ${qqGroup}`}
              data-copy-group={qqGroup}
            >
              <strong>{qqGroup}</strong>
              <svg class="recruitment-contact__copy-icon" viewBox="0 0 24 24" aria-hidden="true">
                <rect x="8" y="8" width="11" height="11" rx="2"></rect>
                <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
              </svg>
              <svg class="recruitment-contact__check-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="m5 12 4 4L19 6"></path>
              </svg>
              <span class="sr-only" data-copy-label>复制群号</span>
            </button>
          </dd>
        </div>
      </dl>
    )
  }

  <span class="sr-only" aria-live="polite" data-copy-status></span>
</div>

<script>
  const contacts = document.querySelectorAll<HTMLElement>('[data-recruitment-contact]');

  const fallbackCopy = (value: string) => {
    const textarea = document.createElement('textarea');
    textarea.value = value;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.append(textarea);
    textarea.select();

    let copied = false;
    try {
      const legacyDocument = document as unknown as {
        execCommand: (command: string) => boolean;
      };
      copied = legacyDocument.execCommand('copy');
    } catch {
      copied = false;
    }

    textarea.remove();
    return copied;
  };

  contacts.forEach((contact) => {
    const copyStatus = contact.querySelector<HTMLElement>('[data-copy-status]');

    contact.querySelectorAll<HTMLButtonElement>('[data-copy-group]').forEach((button) => {
      button.addEventListener('click', async () => {
        const group = button.dataset.copyGroup;
        if (!group) return;

        let copied = false;
        try {
          await navigator.clipboard.writeText(group);
          copied = true;
        } catch {
          copied = fallbackCopy(group);
        }

        const label = button.querySelector<HTMLElement>('[data-copy-label]');
        const originalLabel = label?.textContent ?? '';
        const originalAriaLabel = button.getAttribute('aria-label') ?? '';

        button.classList.toggle('is-copied', copied);
        if (label) label.textContent = copied ? '已复制' : '复制失败';
        button.setAttribute(
          'aria-label',
          copied ? 'QQ群号已复制' : `复制失败，请手动复制群号 ${group}`,
        );
        if (copyStatus) {
          copyStatus.textContent = copied
            ? `QQ群号 ${group} 已复制`
            : `复制失败，请手动复制群号 ${group}`;
        }

        window.setTimeout(() => {
          button.classList.remove('is-copied');
          if (label) label.textContent = originalLabel;
          if (originalAriaLabel) button.setAttribute('aria-label', originalAriaLabel);
        }, 1800);
      });
    });
  });
</script>

<style>
  .recruitment-contact {
    position: relative;
  }

  .recruitment-contact--compact {
    z-index: 4;
    width: fit-content;
    max-width: 100%;
  }

  .recruitment-contact__compact {
    display: grid;
    grid-template-columns: auto auto auto;
    min-height: 4.4rem;
    align-items: center;
    gap: 0.8rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--surface-card);
    box-shadow: var(--shadow-card);
  }

  .recruitment-contact__compact-title {
    color: var(--ink);
    font-size: 0.98rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .recruitment-contact__copy {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .recruitment-contact__number {
    padding-bottom: 0.08rem;
    border-bottom: 1px solid var(--line-strong);
    font-family: var(--font-mono);
    font-size: 0.86rem;
  }

  .recruitment-contact__copy svg,
  .recruitment-contact__group svg {
    width: 1rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .recruitment-contact__check-icon {
    display: none;
  }

  .recruitment-contact__copy:hover,
  .recruitment-contact__copy:focus-visible,
  .recruitment-contact__group:hover,
  .recruitment-contact__group:focus-visible {
    color: var(--blue-700);
  }

  .recruitment-contact__copy.is-copied .recruitment-contact__copy-icon,
  .recruitment-contact__group.is-copied .recruitment-contact__copy-icon {
    display: none;
  }

  .recruitment-contact__copy.is-copied .recruitment-contact__check-icon,
  .recruitment-contact__group.is-copied .recruitment-contact__check-icon {
    display: block;
  }

  .recruitment-contact__list {
    margin-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .recruitment-contact__list > div {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }

  .recruitment-contact__list dt {
    font-size: var(--text-small);
    font-weight: 680;
  }

  .recruitment-contact__list dd {
    display: flex;
    min-width: 0;
    align-items: baseline;
    gap: 0.75rem;
    color: var(--ink-soft);
  }

  .recruitment-contact__list dd > strong,
  .recruitment-contact__group strong {
    color: var(--ink);
    font-weight: 680;
  }

  .recruitment-contact__list dd > span,
  .recruitment-contact__group span {
    color: var(--muted);
    font-size: var(--text-small);
  }

  .recruitment-contact__group {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    text-align: left;
  }

  .recruitment-contact__group.is-copied {
    color: var(--blue-700);
  }

  @media (max-width: 560px) {
    .recruitment-contact__compact {
      grid-template-columns: auto auto minmax(0, 1fr);
      gap: 0.6rem;
      padding-inline: 0.65rem;
    }

    .recruitment-contact__compact-title {
      font-size: 0.9rem;
    }

    .recruitment-contact__number {
      font-size: 0.78rem;
    }

    .recruitment-contact__list > div {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }

    .recruitment-contact__list dd,
    .recruitment-contact__group {
      flex-wrap: wrap;
      gap: 0.35rem 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .recruitment-contact__copy,
    .recruitment-contact__group {
      transition: none;
    }
  }
</style>
