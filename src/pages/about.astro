---
import BaseLayout from '../layouts/BaseLayout.astro';

const practiceItems = [
  {
    index: '01',
    title: '数字校园',
    description:
      '参与一卡通、校级核心应用等业务系统的运行管理，维护学校信息门户，并持续推进 Web 与微信小程序等应用开发。',
    signal: 'OPERATIONS / DEVELOPMENT',
  },
  {
    index: '02',
    title: '网络安全',
    description:
      '以安全组为主，围绕 Web 安全、渗透测试、二进制漏洞挖掘、逆向工程、移动端安全与电子取证持续学习研究。',
    signal: 'SECURITY / RESEARCH',
  },
  {
    index: '03',
    title: '竞赛实战',
    description:
      '参加各类 CTF / AWD 赛事，曾在多项全国性大型网络安全赛事中取得重要奖项，目前仍有十余名成员活跃在竞赛一线。',
    signal: 'CTF · AWD / TEAMWORK',
  },
  {
    index: '04',
    title: '培养与分享',
    description:
      '建立严格的考核制度与完整的学习路线、资源，由学长学姐无偿指导，并开展对外技术培训与交流。',
    signal: 'LEARNING / TRAINING',
  },
];
---

<BaseLayout
  title="关于我们"
  description="了解智邮普创工作室的数字校园实践、网络安全研究、工程开发与人才培养。"
  image="/images/about/lab-awards-wall-1600.webp"
>
  <section class="about-page" aria-labelledby="about-title">
    <div class="shell">
      <header class="about-intro">
        <p class="eyebrow">ABOUT ZYPC / 关于我们</p>
        <h1 id="about-title">关于智邮普创</h1>
        <div class="about-intro__copy">
          <p>
            智邮普创工作室伴随西安邮电大学数据中心建设而成立，现为信息中心下属学生技术实验室，位于长安校区西区图书馆五楼。团队依托校内软硬件环境，研究前沿计算机技术、开发特色应用系统，推动数字校园建设。
          </p>
          <p>
            作为连接课堂理论与真实工程的实战平台，团队参与一卡通、校级核心应用等业务系统的运行管理，也承担学校信息门户维护等工作，在服务校园的过程中培养工程意识与技术责任感。
          </p>
        </div>

        <dl class="about-facts" id="location" aria-label="团队基本信息">
          <div>
            <dt>EST.</dt>
            <dd>2013 成立</dd>
          </div>
          <div>
            <dt>TEAM</dt>
            <dd>信息中心学生实验室</dd>
          </div>
          <div>
            <dt>LOCATION</dt>
            <dd>西区图书馆 5F</dd>
          </div>
          <div>
            <dt>OPEN</dt>
            <dd>公益免费</dd>
          </div>
        </dl>
      </header>

      <figure class="about-photo">
        <div class="about-photo__frame">
          <img
            src="/images/about/lab-awards-wall-960.webp"
            srcset="/images/about/lab-awards-wall-960.webp 960w, /images/about/lab-awards-wall-1600.webp 1600w"
            sizes="(max-width: 760px) min(calc(100vw - 2rem), 320px), 800px"
            width="1600"
            height="1200"
            alt="智邮普创工作室荣誉展示区与实验室标识"
            fetchpriority="high"
          />
        </div>
        <figcaption>
          <span>01 / SPACE</span>
          智邮普创工作室荣誉展示区 · 长安校区西区图书馆五楼
        </figcaption>
      </figure>

      <section class="about-practice" aria-labelledby="practice-title">
        <div class="about-section__heading">
          <div>
            <p class="eyebrow">WHAT WE DO / 我们在做什么</p>
            <h2 id="practice-title">从校园系统到安全竞赛</h2>
          </div>
          <p>真实业务提供问题，安全研究拓展边界，竞赛与分享检验并传递能力。</p>
        </div>

        <div class="practice-grid">
          {
            practiceItems.map((item) => (
              <article class="practice-card">
                <div class="practice-card__heading">
                  <span>{item.index}</span>
                  <h3>{item.title}</h3>
                </div>
                <p>{item.description}</p>
                <div class="practice-card__signal">
                  <i aria-hidden="true"></i>
                  <span>{item.signal}</span>
                </div>
              </article>
            ))
          }
        </div>
      </section>

    </div>
  </section>

</BaseLayout>

<style>
  .about-page {
    overflow: clip;
    padding: 7rem 0 3.25rem;
    background:
      radial-gradient(circle at 86% 8%, rgba(88, 175, 229, 0.12), transparent 28rem),
      var(--paper);
  }

  .about-intro h1 {
    margin-top: 1rem;
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    font-weight: 660;
    letter-spacing: var(--tracking-heading);
    line-height: 1.2;
  }

  .about-intro__copy {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    margin-top: 1.5rem;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.25vw, 1.0625rem);
    line-height: 1.82;
  }

  .about-intro__copy p + p {
    padding-left: clamp(1.5rem, 4vw, 3.5rem);
    border-left: 1px solid var(--line-strong);
  }

  .about-facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 1.5rem;
    scroll-margin-top: 6.5rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .about-facts > div {
    display: flex;
    min-height: 3.8rem;
    align-items: center;
    gap: 0.55rem;
    padding: 0.75rem 1.25rem;
    border-right: 1px solid var(--line);
  }

  .about-facts > div:last-child {
    border-right: 0;
  }

  .about-facts dt {
    color: var(--orange);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .about-facts dd {
    color: var(--ink);
    font-size: var(--text-small);
    font-weight: 650;
  }

  .about-photo {
    max-width: 50rem;
    margin: 2.25rem auto 0;
  }

  .about-photo__frame {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper-deep);
    box-shadow: var(--shadow-soft);
  }

  .about-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 48%;
  }

  .about-photo figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0.25rem 0;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .about-photo figcaption span {
    color: var(--blue-700);
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .about-practice {
    margin-top: 3.25rem;
  }

  .about-section__heading {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
    align-items: end;
    gap: 2rem;
  }

  .about-section__heading h2 {
    margin-top: 0.8rem;
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    font-weight: 660;
    letter-spacing: var(--tracking-heading);
    line-height: 1.2;
  }

  .about-section__heading > p {
    max-width: 28rem;
    justify-self: end;
    color: var(--muted);
    font-size: var(--text-small);
    line-height: 1.75;
  }

  .practice-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-top: 1.75rem;
    border-top: 1px solid var(--line-strong);
  }

  .practice-card {
    display: flex;
    flex-direction: column;
    padding: 1.4rem clamp(1.25rem, 2.5vw, 2rem);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line-strong);
  }

  .practice-card:nth-child(odd) {
    padding-left: 0;
  }

  .practice-card:nth-child(even) {
    padding-right: 0;
    border-right: 0;
  }

  .practice-card__heading {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .practice-card__heading span {
    color: var(--orange);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 700;
  }

  .practice-card h3 {
    font-size: 1.125rem;
    font-weight: 670;
  }

  .practice-card > p {
    margin-top: 0.8rem;
    color: var(--muted);
    font-size: var(--text-small);
    line-height: 1.75;
  }

  .practice-card__signal {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: auto;
    padding-top: 1.35rem;
    color: var(--blue-700);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .practice-card__signal i {
    width: 1.25rem;
    height: 2px;
    background: var(--orange);
  }

  @media (max-width: 900px) {
    .about-intro__copy,
    .about-section__heading {
      grid-template-columns: 1fr;
    }

    .about-intro__copy {
      gap: 0.9rem;
    }

    .about-intro__copy p + p {
      padding-top: 0.9rem;
      padding-left: 0;
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .about-facts {
      grid-template-columns: repeat(2, 1fr);
    }

    .about-facts > div {
      border-bottom: 1px solid var(--line);
    }

    .about-facts > div:nth-child(even) {
      border-right: 0;
    }

    .about-facts > div:nth-child(n + 3) {
      border-bottom: 0;
    }

    .about-section__heading > p {
      justify-self: start;
    }

  }

  @media (max-width: 760px) {
    .about-page {
      padding: 6.5rem 0 2.75rem;
    }

    .about-intro h1 {
      margin-top: 0.75rem;
      font-size: 1.65rem;
    }

    .about-intro__copy {
      margin-top: 1.25rem;
      font-size: 0.9375rem;
      line-height: 1.75;
    }

    .about-facts {
      margin-top: 1.5rem;
    }

    .about-facts > div {
      min-height: 3.4rem;
      padding: 0.65rem 0.8rem;
    }

    .about-facts dt {
      font-size: 0.8125rem;
    }

    .about-facts dd {
      font-size: 0.8125rem;
    }

    .about-photo {
      width: min(100%, 20rem);
      margin-top: 2rem;
    }

    .about-photo__frame {
      aspect-ratio: 4 / 3;
      border-radius: var(--radius-md);
    }

    .about-photo img {
      object-position: center;
    }

    .about-photo figcaption {
      display: grid;
      justify-content: start;
      gap: 0.25rem;
      padding-top: 0.65rem;
      line-height: 1.5;
    }

    .about-practice {
      margin-top: 2.75rem;
    }

    .about-section__heading {
      gap: 0.8rem;
    }

    .about-section__heading h2 {
      margin-top: 0.65rem;
      font-size: 1.65rem;
    }

    .practice-grid {
      grid-template-columns: 1fr;
      margin-top: 1.5rem;
    }

    .practice-card,
    .practice-card:nth-child(odd),
    .practice-card:nth-child(even) {
      padding: 1.15rem 0.25rem;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .practice-card:last-child {
      border-bottom: 0;
    }

    .practice-card__signal {
      padding-top: 0.9rem;
    }

  }

  @media (max-width: 420px) {
    .about-facts {
      grid-template-columns: 1fr;
    }

    .about-facts > div,
    .about-facts > div:nth-child(n + 3) {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .about-facts > div:last-child {
      border-bottom: 0;
    }
  }
</style>
