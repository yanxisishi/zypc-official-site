---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = (await getCollection('articles'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const categories = [...new Set(articles.map((article) => article.data.category))];
const years = [...new Set(articles.map((article) => article.data.publishedAt.getFullYear()))];
---

<BaseLayout
  title="文章"
  description="智邮普创工作室的团队动态、技术文章、赛事复盘与纳新公告。"
>
  <PageHero
    index="06"
    eyebrow="ARTICLES / 文章与复盘"
    title="把过程写清楚，让经验留下来"
    description="这里收录团队动态、公开技术文章、赛事复盘和纳新公告。文章内容只涉及可公开信息，不披露校内系统与未经授权的安全细节。"
    meta="NOTES · WRITEUPS · ANNOUNCEMENTS · RSS"
  />

  <section class="article-directory">
    <div class="shell article-directory__layout">
      <aside class="article-sidebar">
        <div class="search-box">
          <label for="article-search">搜索文章</label>
          <div>
            <input id="article-search" type="search" placeholder="标题、摘要或标签…" autocomplete="off" data-article-search />
            <span aria-hidden="true">⌕</span>
          </div>
        </div>
        <div class="article-sidebar__group">
          <p>CATEGORY / 分类</p>
          <button class="is-active" type="button" data-category-filter="all">
            <span>全部文章</span><small>{articles.length}</small>
          </button>
          {
            categories.map((category) => (
              <button type="button" data-category-filter={category}>
                <span>{category}</span>
                <small>{articles.filter((article) => article.data.category === category).length}</small>
              </button>
            ))
          }
        </div>
        <div class="article-sidebar__group">
          <p>ARCHIVE / 归档</p>
          {
            years.map((year) => (
              <button type="button" data-year-filter={String(year)}>
                <span>{year}</span>
                <small>{articles.filter((article) => article.data.publishedAt.getFullYear() === year).length}</small>
              </button>
            ))
          }
        </div>
        <a class="rss-link" href="/rss.xml">
          <span>RSS</span>
          <div><strong>订阅文章更新</strong><small>无需社交平台算法</small></div>
          <i aria-hidden="true">↗</i>
        </a>
      </aside>

      <div class="article-results">
        <header>
          <div>
            <p>PUBLIC ARCHIVE</p>
            <h2>全部文章</h2>
          </div>
          <p><strong data-article-count>{articles.length}</strong> 篇</p>
        </header>
        <div class="article-grid">
          {
            articles.map((article, index) => (
              <ArticleCard
                id={article.id}
                title={article.data.title}
                description={article.data.description}
                category={article.data.category}
                tags={article.data.tags}
                author={article.data.author}
                publishedAt={article.data.publishedAt}
                sample={article.data.sample}
                featured={index === 0}
              />
            ))
          }
        </div>
        <p class="empty-state article-empty" data-article-empty hidden>没有找到匹配的文章，换个关键词或分类试试。</p>
      </div>
    </div>
  </section>

  <script>
    const input = document.querySelector<HTMLInputElement>('[data-article-search]');
    const cards = document.querySelectorAll<HTMLElement>('[data-article-card]');
    const categoryButtons = document.querySelectorAll<HTMLButtonElement>('[data-category-filter]');
    const yearButtons = document.querySelectorAll<HTMLButtonElement>('[data-year-filter]');
    const count = document.querySelector<HTMLElement>('[data-article-count]');
    const empty = document.querySelector<HTMLElement>('[data-article-empty]');
    let category = 'all';
    let year = 'all';

    const normalize = (value: string) => value.trim().toLocaleLowerCase();

    const apply = () => {
      const query = normalize(input?.value ?? '');
      let visible = 0;
      cards.forEach((card) => {
        const haystack = normalize([
          card.dataset.title,
          card.dataset.description,
          card.dataset.category,
          card.dataset.tags,
        ].join(' '));
        const articleDate = card.querySelector('time')?.getAttribute('datetime') ?? '';
        const matches =
          (!query || haystack.includes(query)) &&
          (category === 'all' || card.dataset.category === category) &&
          (year === 'all' || articleDate.startsWith(year));
        card.hidden = !matches;
        if (matches) visible += 1;
      });
      if (count) count.textContent = String(visible);
      if (empty) empty.hidden = visible !== 0;
    };

    input?.addEventListener('input', apply);
    categoryButtons.forEach((button) => {
      button.addEventListener('click', () => {
        category = button.dataset.categoryFilter ?? 'all';
        categoryButtons.forEach((candidate) => candidate.classList.toggle('is-active', candidate === button));
        apply();
      });
    });
    yearButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const selected = button.dataset.yearFilter ?? 'all';
        year = year === selected ? 'all' : selected;
        yearButtons.forEach((candidate) => candidate.classList.toggle('is-active', year === candidate.dataset.yearFilter));
        apply();
      });
    });
  </script>
</BaseLayout>

<style>
  .article-directory {
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    background: var(--surface);
  }

  .article-directory__layout {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    align-items: start;
    gap: clamp(3rem, 7vw, 6rem);
  }

  .article-sidebar {
    position: sticky;
    top: 7rem;
    display: grid;
    gap: 2rem;
  }

  .search-box label {
    display: block;
    margin-bottom: 0.55rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
  }

  .search-box > div {
    position: relative;
  }

  .search-box input {
    width: 100%;
    height: 3rem;
    padding: 0 2.3rem 0 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper);
    color: var(--ink);
    font-size: 0.82rem;
  }

  .search-box div > span {
    position: absolute;
    top: 50%;
    right: 0.8rem;
    color: var(--blue-700);
    transform: translateY(-50%);
  }

  .article-sidebar__group {
    display: grid;
    gap: 0.25rem;
  }

  .article-sidebar__group > p {
    margin-bottom: 0.4rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
  }

  .article-sidebar__group button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.7rem;
    border: 0;
    border-radius: 0.55rem;
    background: transparent;
    color: var(--ink-soft);
    font-size: 0.78rem;
    text-align: left;
    cursor: pointer;
  }

  .article-sidebar__group button:hover,
  .article-sidebar__group button.is-active {
    background: var(--blue-50);
    color: var(--blue-700);
  }

  .article-sidebar__group small {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
  }

  .rss-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem;
    border-radius: var(--radius-sm);
    background: var(--orange-soft);
    color: var(--ink);
    text-decoration: none;
  }

  .rss-link > span {
    display: grid;
    width: 2.3rem;
    height: 2.3rem;
    place-items: center;
    border-radius: 50%;
    background: var(--orange);
    color: var(--action-text);
    font-family: var(--font-mono);
    font-size: 0.6rem;
  }

  .rss-link div {
    display: grid;
  }

  .rss-link strong {
    font-size: 0.76rem;
  }

  .rss-link small {
    color: var(--muted);
    font-size: 0.62rem;
  }

  .rss-link i {
    font-style: normal;
  }

  .article-results > header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .article-results > header div p {
    color: var(--blue-700);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
  }

  .article-results > header h2 {
    margin-top: 0.3rem;
    font-size: var(--text-section);
    font-weight: 650;
    letter-spacing: var(--tracking-heading);
  }

  .article-results > header > p {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .article-results > header strong {
    color: var(--blue-700);
    font-size: 1.1rem;
  }

  .article-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1rem;
  }

  :global(.article-grid [data-article-card][hidden]) {
    display: none;
  }

  .article-empty {
    margin-top: 2rem;
  }

  .article-empty[hidden] {
    display: none;
  }

  @media (max-width: 900px) {
    .article-directory__layout {
      grid-template-columns: 1fr;
    }

    .article-sidebar {
      position: static;
      grid-template-columns: 1fr 1fr;
    }

    .search-box,
    .rss-link {
      grid-column: 1 / 3;
    }
  }

  @media (max-width: 650px) {
    .article-sidebar {
      grid-template-columns: 1fr;
    }

    .search-box,
    .rss-link {
      grid-column: auto;
    }

    .article-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
