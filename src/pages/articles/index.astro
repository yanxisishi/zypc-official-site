---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { countArticleWords } from '../../utils/article';

const articles = (await getCollection('articles'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout
  title="文章"
  description="记录智邮普创工作室的团队动态、技术实践、赛事复盘与纳新信息。"
>
  <main class="articles-page">
    <header class="articles-intro">
      <div class="shell articles-intro__inner">
        <div class="articles-intro__copy">
          <p class="eyebrow">ARTICLES / 团队记录</p>
          <h1>文章</h1>
          <p>记录团队动态、技术实践、赛事复盘与纳新信息。</p>
        </div>
        {
          articles.length > 0 && (
            <form class="article-search" role="search" data-article-search-form>
              <div class="article-search__heading">
                <label for="article-search-input">搜索文章</label>
                <p aria-live="polite" data-article-search-status>
                  共 {articles.length} 篇文章
                </p>
              </div>
              <div class="article-search__field">
                <svg
                  viewBox="0 0 24 24"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="10.75" cy="10.75" r="6.25" fill="none"></circle>
                  <path d="m15.5 15.5 4 4" fill="none"></path>
                </svg>
                <input
                  id="article-search-input"
                  type="search"
                  placeholder="输入标题、摘要或标签"
                  autocomplete="off"
                  aria-controls="article-list"
                  data-article-search-input
                />
              </div>
            </form>
          )
        }
      </div>
    </header>

    <section class="article-archive" aria-labelledby="article-list-title">
      <div class="shell article-archive__inner">
        <h2 class="sr-only" id="article-list-title">文章列表</h2>
        {
          articles.length > 0 ? (
            <ol class="article-list" id="article-list">
              {articles.map((article) => (
                <li
                  data-article-search={[
                    article.data.title,
                    article.data.description,
                    ...article.data.tags,
                  ].join(' ')}
                >
                  <ArticleCard
                    id={article.id}
                    title={article.data.title}
                    description={article.data.description}
                    tags={article.data.tags}
                    publishedAt={article.data.publishedAt}
                    wordCount={countArticleWords(article.body ?? '')}
                    cover={article.data.cover}
                  />
                </li>
              ))}
            </ol>
            <p class="article-no-results" data-article-no-results hidden>
              没有找到匹配的文章，换个关键词试试。
            </p>
          ) : (
            <p class="article-empty">文章正在整理中。</p>
          )
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .articles-page {
    min-height: calc(100svh - 16.75rem);
    background: var(--paper);
  }

  .articles-intro {
    padding: 6.55rem 0 1.15rem;
  }

  .articles-intro__inner,
  .article-archive__inner {
    max-width: 70rem;
  }

  .articles-intro__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 22rem);
    align-items: end;
    gap: 2rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--line);
  }

  .articles-intro h1 {
    margin-top: 0.45rem;
    color: var(--ink);
    font-size: clamp(2rem, 3vw, 2.25rem);
    font-weight: 680;
    letter-spacing: var(--tracking-heading);
    line-height: 1.1;
  }

  .articles-intro__copy > p:last-child {
    margin-top: 0.45rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .article-search {
    display: grid;
    gap: 0.45rem;
    margin: 0;
  }

  .article-search__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .article-search__heading label {
    color: var(--ink-soft);
    font-size: var(--text-meta);
    font-weight: 650;
    letter-spacing: 0.04em;
  }

  .article-search__heading p {
    color: var(--muted);
    font-size: var(--text-meta);
  }

  .article-search__field {
    position: relative;
  }

  .article-search__field svg {
    position: absolute;
    top: 50%;
    left: 0.85rem;
    width: 1rem;
    height: 1rem;
    color: var(--muted);
    stroke-width: 1.7;
    pointer-events: none;
    transform: translateY(-50%);
  }

  .article-search input {
    width: 100%;
    height: 2.75rem;
    padding: 0 0.9rem 0 2.4rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    outline: none;
    background: var(--surface-card);
    color: var(--ink);
    font-size: 0.84rem;
    appearance: none;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      background-color 180ms ease;
  }

  .article-search input::placeholder {
    color: var(--muted);
    opacity: 0.78;
  }

  .article-search input::-webkit-search-cancel-button {
    appearance: none;
  }

  .article-search input:focus-visible {
    border-color: var(--blue);
    background: var(--surface);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--blue) 16%, transparent);
  }

  .article-archive {
    padding: 0 0 clamp(3rem, 5vw, 4.5rem);
  }

  .article-list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-empty {
    padding: 3rem 0;
    color: var(--muted);
    text-align: center;
  }

  .article-no-results {
    padding: 3rem 0;
    color: var(--muted);
    font-size: 0.9rem;
    text-align: center;
  }

  @media (max-width: 800px) {
    .articles-intro__inner {
      grid-template-columns: 1fr;
      gap: 1.15rem;
    }

    .article-search {
      width: min(100%, 25rem);
    }
  }

  @media (max-width: 650px) {
    .articles-intro {
      padding: 5.85rem 0 1rem;
    }

    .articles-intro__inner {
      padding-bottom: 1rem;
    }

    .articles-intro h1 {
      margin-top: 0.35rem;
      font-size: 1.75rem;
    }

    .articles-intro__copy > p:last-child {
      margin-top: 0.35rem;
      font-size: 0.875rem;
    }

    .article-archive {
      padding-bottom: 3rem;
    }

    .article-list {
      gap: 0.65rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-search input {
      transition: none;
    }
  }
</style>

<script>
  const searchForm = document.querySelector<HTMLFormElement>('[data-article-search-form]');
  const searchInput = document.querySelector<HTMLInputElement>('[data-article-search-input]');
  const searchStatus = document.querySelector<HTMLElement>('[data-article-search-status]');
  const noResults = document.querySelector<HTMLElement>('[data-article-no-results]');
  const articleItems = Array.from(
    document.querySelectorAll<HTMLElement>('[data-article-search]'),
  );

  const normalizeSearchText = (value: string) =>
    value.normalize('NFKC').toLocaleLowerCase('zh-CN').trim();

  const updateArticleResults = () => {
    if (!searchInput || !searchStatus) return;

    const terms = normalizeSearchText(searchInput.value).split(/\s+/).filter(Boolean);
    let visibleCount = 0;

    articleItems.forEach((item) => {
      const searchableText = normalizeSearchText(item.dataset.articleSearch ?? '');
      const matches = terms.every((term) => searchableText.includes(term));
      item.hidden = !matches;
      if (matches) visibleCount += 1;
    });

    searchStatus.textContent = terms.length
      ? `找到 ${visibleCount} 篇匹配文章`
      : `共 ${articleItems.length} 篇文章`;

    if (noResults) noResults.hidden = visibleCount !== 0;
  };

  searchForm?.addEventListener('submit', (event) => event.preventDefault());
  searchInput?.addEventListener('input', updateArticleResults);
  searchInput?.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !searchInput.value) return;
    searchInput.value = '';
    updateArticleResults();
  });
</script>
