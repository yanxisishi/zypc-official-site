---
import { getCollection } from 'astro:content';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const honors = (await getCollection('honors')).sort((a, b) =>
  b.data.year - a.data.year || b.data.month - a.data.month,
);
const years = [...new Set(honors.map((honor) => honor.data.year))];
---

<BaseLayout
  title="荣誉成果"
  description="智邮普创工作室已确认的竞赛记录与团队成果。"
>
  <PageHero
    index="04"
    eyebrow="HONORS / 竞赛荣誉"
    title="每一次交锋，都是能力坐标"
    description="荣誉页只记录经过确认的比赛、名次与参赛成员。排名不是学习的唯一尺度，但它忠实记录了团队在特定时间、特定赛场上的共同努力。"
    meta={`${honors.length} VERIFIED RECORDS · MORE TO COME`}
  />

  <section class="honors section-pad">
    <div class="shell">
      <div class="honors__heading">
        <SectionHeading
          eyebrow="COMPETITION ARCHIVE / 赛事档案"
          title="按年份回看我们的赛场记录"
          description="这里整理已确认的公开赛场记录，新的比赛与复盘会在核实后持续补充。"
        />
        <p aria-live="polite"><strong data-honor-count>{honors.length}</strong> 条记录</p>
      </div>

      {
        years.length > 1 && (
          <div class="year-filter" aria-label="按年份筛选荣誉">
            <button class="is-active" type="button" data-year-filter="all" aria-pressed="true">
              全部年份
            </button>
            {years.map((year) => (
              <button type="button" data-year-filter={String(year)} aria-pressed="false">
                {year}
              </button>
            ))}
          </div>
        )
      }

      <div class="honor-list">
        {
          honors.map((honor, index) => (
            <article class="honor-card" data-honor-card data-year={honor.data.year} data-reveal>
              <div class="honor-card__number">{String(index + 1).padStart(2, '0')}</div>
              <div class="honor-card__date">
                <strong>{honor.data.year}</strong>
                <span>{String(honor.data.month).padStart(2, '0')} / MONTH</span>
              </div>
              <div class="honor-card__main">
                <div class="honor-card__tags">
                  <span>{honor.data.track}</span>
                  <span>VERIFIED</span>
                </div>
                <h2>{honor.data.competition}</h2>
                <div class="honor-card__result">
                  <strong>{honor.data.award}</strong>
                  {honor.data.rank && <span>{honor.data.rank}</span>}
                </div>
              </div>
              <div class="honor-card__members">
                <p>TEAM MEMBERS</p>
                <ul>
                  {honor.data.members.map((member) => <li>{member}</li>)}
                </ul>
                {
                  honor.data.writeupUrl && (
                    <a href={honor.data.writeupUrl} target="_blank" rel="noreferrer">
                      相关记录 <span aria-hidden="true">↗</span>
                    </a>
                  )
                }
              </div>
            </article>
          ))
        }
      </div>
      <p class="empty-state honor-empty" data-honor-empty hidden>该年份暂无已确认的竞赛记录。</p>
    </div>
  </section>

  <section class="honor-note">
    <div class="shell honor-note__grid">
      <p class="eyebrow">BEYOND THE RANK</p>
      <blockquote>名次会留在榜单上，真正留下来的，是共同解决问题的方法与默契。</blockquote>
      <a class="button button--light" href="/articles/">阅读赛事复盘</a>
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-year-filter]');
    const cards = document.querySelectorAll<HTMLElement>('[data-honor-card]');
    const counter = document.querySelector<HTMLElement>('[data-honor-count]');
    const empty = document.querySelector<HTMLElement>('[data-honor-empty]');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const year = button.dataset.yearFilter ?? 'all';
        let visible = 0;
        buttons.forEach((candidate) => {
          const active = candidate === button;
          candidate.classList.toggle('is-active', active);
          candidate.setAttribute('aria-pressed', String(active));
        });
        cards.forEach((card) => {
          const matches = year === 'all' || card.dataset.year === year;
          card.hidden = !matches;
          if (matches) visible += 1;
        });
        if (counter) counter.textContent = String(visible);
        if (empty) empty.hidden = visible !== 0;
      });
    });
  </script>
</BaseLayout>

<style>
  .section-pad {
    padding: var(--space-section) 0;
  }

  .honors {
    background: var(--surface);
  }

  .honors__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .honors__heading > p {
    flex: 0 0 auto;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
  }

  .honors__heading strong {
    color: var(--blue-700);
    font-size: 1.15rem;
  }

  .year-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 3rem;
  }

  .year-filter button {
    min-height: 2.75rem;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink-soft);
    font-size: var(--text-meta);
    cursor: pointer;
  }

  .year-filter button:hover {
    border-color: var(--blue);
  }

  .year-filter button.is-active {
    border-color: var(--action-bg);
    background: var(--action-bg);
    color: var(--action-text);
  }

  .honor-list {
    margin-top: 2rem;
    border-top: 1px solid var(--line-strong);
  }

  .honor-card {
    display: grid;
    grid-template-columns: 3rem 7rem minmax(0, 1.7fr) minmax(13rem, 0.8fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--line);
  }

  .honor-card[hidden] {
    display: none;
  }

  .honor-card__number {
    color: var(--orange);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
  }

  .honor-card__date {
    display: grid;
    align-content: start;
    gap: 0.25rem;
  }

  .honor-card__date strong {
    color: var(--blue-700);
    font-family: var(--font-mono);
    font-size: 1.65rem;
  }

  .honor-card__date span,
  .honor-card__members > p {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0.09em;
  }

  .honor-card__tags {
    display: flex;
    gap: 0.45rem;
  }

  .honor-card__tags span {
    padding: 0.28rem 0.48rem;
    border-radius: 999px;
    background: var(--blue-50);
    color: var(--blue-700);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
  }

  .honor-card__tags span:last-child {
    background: var(--orange-soft);
    color: var(--orange-ink);
  }

  .honor-card h2 {
    max-width: 44rem;
    margin-top: 0.8rem;
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    font-weight: 650;
    letter-spacing: -0.018em;
    line-height: 1.35;
  }

  .honor-card__result {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.25rem;
  }

  .honor-card__result strong {
    color: var(--orange);
    font-size: 1rem;
  }

  .honor-card__result span {
    color: var(--muted);
    font-size: var(--text-small);
  }

  .honor-card__members ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding: 0;
    margin: 0.75rem 0 0;
    list-style: none;
  }

  .honor-card__members li {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: var(--text-small);
  }

  .honor-card__members li + li::before {
    margin-right: 0.45rem;
    color: var(--line-strong);
    content: '/';
  }

  .honor-card__members a {
    display: inline-flex;
    gap: 0.4rem;
    margin-top: 1.25rem;
    color: var(--blue-700);
    font-size: var(--text-meta);
    font-weight: 650;
    text-decoration: none;
  }

  .honor-empty {
    margin-top: 2rem;
  }

  .honor-empty[hidden] {
    display: none;
  }

  .honor-note {
    padding: var(--space-section) 0;
    background: var(--deep);
    color: var(--on-deep);
  }

  .honor-note__grid {
    display: grid;
    grid-template-columns: 0.55fr 2fr auto;
    align-items: end;
    gap: 3rem;
  }

  .honor-note .eyebrow {
    align-self: start;
    color: var(--blue-300);
  }

  .honor-note blockquote {
    font-size: var(--text-feature);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    line-height: 1.3;
  }

  @media (max-width: 900px) {
    .honor-card {
      grid-template-columns: 2rem 5.5rem 1fr;
    }

    .honor-card__members {
      grid-column: 3;
    }

    .honor-note__grid {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (max-width: 620px) {
    .honors__heading {
      align-items: start;
      flex-direction: column;
    }

    .honor-card {
      grid-template-columns: 2rem 1fr;
    }

    .honor-card__date {
      grid-column: 2;
    }

    .honor-card__main,
    .honor-card__members {
      grid-column: 1 / 3;
      padding-left: 3rem;
    }
  }
</style>
