---
import BaseLayout from '../layouts/BaseLayout.astro';
import honorGroups from '../data/honors';

const groups = honorGroups
  .filter((group) => group.entries.length > 0)
  .map((group) => ({
    ...group,
    entries: [...group.entries].sort((a, b) => b.month - a.month),
  }))
  .sort((a, b) => b.year - a.year);

const recordCount = groups.reduce((total, group) => total + group.entries.length, 0);
const newestYear = groups.at(0)?.year;
const oldestYear = groups.at(-1)?.year;
const yearRange =
  newestYear && oldestYear
    ? newestYear === oldestYear
      ? String(newestYear)
      : `${oldestYear}—${newestYear}`
    : '待补充';
---

<BaseLayout
  title="团队荣誉"
  description="智邮普创工作室经过确认的竞赛记录与团队成果。"
>
  <main class="honors-page">
    <section class="honors-masthead" aria-labelledby="honors-title">
      <div class="shell honors-masthead__inner">
        <p class="honors-eyebrow"><span aria-hidden="true"></span> HONORS / 竞赛档案</p>

        <div class="honors-masthead__content">
          <div>
            <h1 id="honors-title">团队荣誉</h1>
          </div>

          <dl class="honors-summary" aria-label="荣誉档案概览">
            <div>
              <dt>公开记录</dt>
              <dd>{String(recordCount).padStart(2, '0')}</dd>
            </div>
            <div>
              <dt>年份范围</dt>
              <dd>{yearRange}</dd>
            </div>
          </dl>
        </div>

        {
          groups.length > 1 && (
            <nav class="honors-year-nav" aria-label="按年份浏览">
              {groups.map((group) => (
                <a href={`#honors-${group.year}`}>{group.year}</a>
              ))}
            </nav>
          )
        }
      </div>
    </section>

    <section class="honors-archive" aria-label="荣誉记录">
      <div class="shell">
        {
          groups.length > 0 ? (
            groups.map((group) => (
              <section
                class="honor-year"
                id={`honors-${group.year}`}
                aria-labelledby={`honors-${group.year}-title`}
              >
                <header class="honor-year__header">
                  <div>
                    <span>YEAR</span>
                    <h2 id={`honors-${group.year}-title`}>{group.year}</h2>
                  </div>
                  <p>{String(group.entries.length).padStart(2, '0')} 项记录</p>
                </header>

                <ol class="honor-list">
                  {group.entries.map((honor, index) => {
                    const month = String(honor.month).padStart(2, '0');
                    return (
                      <li>
                        <article class="honor-entry">
                          <span class="honor-entry__number" aria-hidden="true">
                            {String(index + 1).padStart(2, '0')}
                          </span>

                          <time class="honor-entry__date" datetime={`${group.year}-${month}`}>
                            {month}<small>月</small>
                          </time>

                          <div class="honor-entry__main">
                            <div class="honor-entry__meta">
                              <span>{honor.track}</span>
                              {honor.members && honor.members.length > 0 && (
                                <p>
                                  <b>TEAM</b>
                                  {honor.members.join(' / ')}
                                </p>
                              )}
                            </div>

                            <h3>
                              {honor.url ? (
                                <a href={honor.url} target="_blank" rel="noreferrer">
                                  {honor.competition}
                                  <span aria-hidden="true">↗</span>
                                </a>
                              ) : (
                                honor.competition
                              )}
                            </h3>
                          </div>

                          <div class="honor-entry__result">
                            <strong>{honor.award}</strong>
                            {honor.rank && <span>{honor.rank}</span>}
                          </div>
                        </article>
                      </li>
                    );
                  })}
                </ol>
              </section>
            ))
          ) : (
            <p class="honors-empty">荣誉记录正在整理中。</p>
          )
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .honors-page {
    min-height: 70vh;
    background:
      radial-gradient(circle at 82% 5%, rgba(91, 185, 229, 0.08), transparent 26rem),
      var(--paper);
  }

  .honors-masthead {
    padding: 6.4rem 0 1.15rem;
  }

  .honors-masthead__inner {
    padding-bottom: 1.35rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .honors-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--blue-700);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .honors-eyebrow span {
    width: 1.75rem;
    height: 1px;
    background: currentColor;
  }

  .honors-masthead__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: clamp(1.5rem, 5vw, 4rem);
    margin-top: 1rem;
  }

  .honors-masthead h1 {
    font-size: clamp(1.85rem, 2.5vw, 2.15rem);
    font-weight: 680;
    letter-spacing: -0.035em;
    line-height: 1.12;
  }

  .honors-summary {
    display: grid;
    grid-template-columns: repeat(2, auto);
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .honors-summary div {
    display: grid;
    min-width: 8rem;
    gap: 0.15rem;
    padding: 0.6rem 0.9rem;
  }

  .honors-summary div + div {
    border-left: 1px solid var(--line);
  }

  .honors-summary dt,
  .honor-year__header span {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
  }

  .honors-summary dd {
    margin: 0;
    color: var(--blue-700);
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 700;
  }

  .honors-year-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 0.9rem;
  }

  .honors-year-nav a {
    color: var(--blue-700);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-underline-offset: 0.35rem;
  }

  .honors-archive {
    padding: 0 0 clamp(4rem, 8vw, 7rem);
  }

  .honor-year {
    scroll-margin-top: 6rem;
  }

  .honor-year + .honor-year {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .honor-year__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 0.8rem;
  }

  .honor-year__header > div {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .honor-year__header h2 {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 1.75rem;
    font-weight: 680;
    letter-spacing: -0.04em;
  }

  .honor-year__header > p {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .honor-list {
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line-strong);
    list-style: none;
  }

  .honor-list > li {
    border-bottom: 1px solid var(--line);
  }

  .honor-entry {
    display: grid;
    grid-template-columns: 2.25rem 4rem minmax(0, 1fr) minmax(10rem, auto);
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    min-height: 6rem;
    padding: 1rem 0.75rem;
    transition: background-color 160ms ease, transform 160ms ease;
  }

  .honor-entry:hover,
  .honor-entry:focus-within {
    background: rgba(88, 175, 229, 0.055);
    transform: translateX(0.2rem);
  }

  .honor-entry__number {
    color: var(--orange);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .honor-entry__date {
    color: var(--blue-700);
    font-family: var(--font-mono);
    font-size: 1.2rem;
    font-weight: 700;
  }

  .honor-entry__date small {
    margin-left: 0.18rem;
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 500;
  }

  .honor-entry__main {
    min-width: 0;
  }

  .honor-entry__meta {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.75rem;
    color: var(--muted);
    font-size: 0.75rem;
  }

  .honor-entry__meta > span {
    flex: 0 0 auto;
    padding: 0.18rem 0.42rem;
    border-radius: 0.25rem;
    background: var(--blue-50);
    color: var(--blue-700);
    font-family: var(--font-mono);
  }

  .honor-entry__meta p {
    overflow: hidden;
    min-width: 0;
    font-family: var(--font-mono);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .honor-entry__meta b {
    margin-right: 0.5rem;
    color: var(--ink-soft);
    font-size: 0.66rem;
    letter-spacing: 0.09em;
  }

  .honor-entry h3 {
    margin-top: 0.55rem;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    font-weight: 640;
    letter-spacing: -0.015em;
    line-height: 1.45;
  }

  .honor-entry h3 a {
    color: inherit;
    text-decoration: none;
  }

  .honor-entry h3 a span {
    margin-left: 0.3rem;
    color: var(--blue-700);
    font-size: 0.8em;
  }

  .honor-entry h3 a:hover,
  .honor-entry h3 a:focus-visible {
    color: var(--blue-700);
  }

  .honor-entry__result {
    display: grid;
    justify-items: end;
    gap: 0.3rem;
    text-align: right;
  }

  .honor-entry__result strong {
    color: var(--orange);
    font-size: 0.9375rem;
    font-weight: 680;
  }

  .honor-entry__result span {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .honors-empty {
    padding: 4rem 0;
    color: var(--muted);
    text-align: center;
  }

  @media (max-width: 800px) {
    .honors-masthead__content {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.1rem;
    }

    .honors-summary {
      width: min(100%, 22rem);
    }

    .honors-summary div {
      min-width: 0;
    }

    .honor-entry {
      grid-template-columns: 2rem 3.5rem minmax(0, 1fr);
    }

    .honor-entry__result {
      grid-column: 3;
      grid-auto-flow: column;
      justify-content: start;
      justify-items: start;
      gap: 0.75rem;
      text-align: left;
    }
  }

  @media (max-width: 560px) {
    .honors-masthead {
      padding-top: 5.85rem;
      padding-bottom: 0.9rem;
    }

    .honors-masthead__inner {
      padding-bottom: 1rem;
    }

    .honors-masthead h1 {
      font-size: 1.75rem;
    }

    .honors-summary {
      width: 100%;
    }

    .honors-summary div {
      padding: 0.6rem 0.7rem;
    }

    .honor-entry {
      grid-template-columns: 1.75rem 3rem minmax(0, 1fr);
      gap: 0.35rem 0.55rem;
      min-height: 0;
      padding: 1rem 0.25rem;
    }

    .honor-entry__number {
      grid-row: 1 / 3;
      align-self: start;
      padding-top: 0.2rem;
    }

    .honor-entry__date {
      grid-row: 1 / 3;
      grid-column: 2;
      align-self: start;
    }

    .honor-entry__main,
    .honor-entry__result {
      grid-column: 3;
    }

    .honor-entry__meta {
      flex-wrap: wrap;
      align-items: center;
      gap: 0.35rem 0.55rem;
    }

    .honor-entry__meta p {
      overflow: visible;
      font-size: 0.8125rem;
      line-height: 1.45;
      text-overflow: clip;
      white-space: normal;
    }

    .honor-entry h3 {
      margin-top: 0.5rem;
      font-size: 1rem;
    }

    .honor-entry__result {
      grid-auto-flow: column;
      align-items: baseline;
      justify-content: start;
      gap: 0.7rem;
      margin-top: 0.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .honor-entry {
      transition: none;
    }
  }
</style>
