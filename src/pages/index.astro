---
import { getCollection, getEntry } from 'astro:content';
import LogoMark from '../components/LogoMark.astro';
import RecruitmentContact from '../components/RecruitmentContact.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';

const allArticles = (await getCollection('articles'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const articles = allArticles.filter((entry) => !entry.data.sample).slice(0, 3);
const honors = await getCollection('honors');

const recruitmentEntry = await getEntry('recruitment', 'main');
const siteEntry = await getEntry('siteSettings', 'main');
if (!recruitmentEntry || !siteEntry) throw new Error('缺少纳新或站点配置');
const recruitment = recruitmentEntry.data;
const site = siteEntry.data;

const facts = [
  {
    value: String(site.founded),
    label: '成立年份',
    detail: '持续在真实校园场景中实践',
  },
  {
    value: String(honors.length),
    label: '已核实赛场记录',
    detail: '公开记录仍在持续整理',
  },
  {
    value: '5F',
    label: '长安校区西区图书馆',
    detail: '实验室线下位置',
  },
];

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('zh-CN', {
    month: '2-digit',
    day: '2-digit',
  }).format(date);
---

<BaseLayout>
  <section class="home" aria-labelledby="home-title">
    <div class="home__signal home__signal--one" aria-hidden="true"></div>
    <div class="home__signal home__signal--two" aria-hidden="true"></div>

    <div class="shell home__content">
      <div class="home-intro">
        <div class="home-intro__copy" data-reveal>
          <p class="eyebrow">XUPT × ZYPC · EST. 2013</p>
          <h1 id="home-title">智邮普创工作室</h1>
          <p class="home-intro__motto">服务数字校园，探索安全边界</p>
          <p class="home-intro__description">
            西安邮电大学信息中心学生技术团队，专注数字校园实践与网络安全研究。
          </p>
          <RecruitmentContact
            cohort={recruitment.cohort}
            qqGroup={recruitment.qqGroup}
            qrCode={recruitment.qrCode}
            status={recruitment.status}
          />
          <div class="home-intro__actions">
            <a class="button" href="/about/">了解团队 <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <div class="home-intro__visual" data-reveal>
          <div class="home-intro__orbit" aria-hidden="true">
            <i></i>
            <i></i>
          </div>
          <LogoMark size="hero" alt="智邮普创工作室 Logo" />
        </div>
      </div>

      <dl class="home-facts" aria-label="团队概况" data-reveal>
        {
          facts.map((fact) => (
            <div>
              <dt>
                <strong>{fact.value}</strong>
                <span>{fact.label}</span>
              </dt>
              <dd>{fact.detail}</dd>
            </div>
          ))
        }
      </dl>

      <section class="home-updates" aria-labelledby="latest-title" data-reveal>
        <header class="home-updates__heading">
          <div>
            <p>RECENT / 最近更新</p>
            <h2 id="latest-title">团队记录</h2>
          </div>
          <a href="/articles/">全部文章 <span aria-hidden="true">→</span></a>
        </header>
        <div class="home-updates__list">
          {
            articles.map((article) => (
              <a href={`/articles/${article.id}/`}>
                <span>
                  <time datetime={article.data.publishedAt.toISOString()}>
                    {formatDate(article.data.publishedAt)}
                  </time>
                  <small>{article.data.category}</small>
                </span>
                <strong>{article.data.title}</strong>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
