---
import { getCollection, getEntry } from 'astro:content';
import LogoMark from '../components/LogoMark.astro';
import RecruitmentContact from '../components/RecruitmentContact.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';

const allArticles = (await getCollection('articles'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const articles = allArticles.slice(0, 3);

const recruitmentEntry = await getEntry('recruitment', 'main');
if (!recruitmentEntry) throw new Error('缺少纳新配置');
const recruitment = recruitmentEntry.data;

const portals = [
  {
    index: '01',
    href: '/about/',
    label: '关于我们',
    detail: '团队介绍与努力方向',
    icon: 'about',
  },
  {
    index: '02',
    href: '/members/',
    label: '团队成员',
    detail: '现役与往届成员',
    icon: 'members',
  },
  {
    index: '03',
    href: '/honors/',
    label: '荣誉成果',
    detail: '组内成员的赛场记录',
    icon: 'honors',
  },
  {
    index: '04',
    href: '/join/',
    label: '加入我们',
    detail: '纳新流程与联系方式',
    icon: 'join',
  },
];

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('zh-CN', {
    month: '2-digit',
    day: '2-digit',
  }).format(date);
---

<BaseLayout>
  <section class="home" aria-labelledby="home-title">
    <div class="home__signal home__signal--one" aria-hidden="true"></div>
    <div class="home__signal home__signal--two" aria-hidden="true"></div>

    <div class="shell home__content">
      <div class="home-intro">
        <div class="home-intro__copy" data-reveal>
          <p class="eyebrow">XUPT × ZYPC · EST. 2013</p>
          <h1 id="home-title">智邮普创工作室</h1>
          <p class="home-intro__motto">服务数字校园，探索安全边界</p>
          <p class="home-intro__description">
            西安邮电大学信息中心学生技术团队，专注数字校园实践与网络安全研究。
          </p>
          <RecruitmentContact
            cohort="2026"
            qqGroup={recruitment.qqGroup}
            wechatAccount={recruitment.wechatAccount}
          />
        </div>

        <div class="home-intro__visual" data-reveal>
          <div class="home-intro__orbit" aria-hidden="true">
            <i></i>
            <i></i>
          </div>
          <LogoMark size="hero" alt="智邮普创工作室 Logo" />
        </div>
      </div>

      <nav class="home-portals" aria-label="首页快捷入口" data-reveal>
        {
          portals.map((portal) => (
            <a class={`home-portal home-portal--${portal.icon}`} href={portal.href}>
              <span class="home-portal__index">{portal.index}</span>
              <div>
                <strong>{portal.label}</strong>
                <small>{portal.detail}</small>
              </div>
              <span class="home-portal__link">进入 <i aria-hidden="true">→</i></span>
              <svg class="home-portal__art" viewBox="0 0 96 96" aria-hidden="true">
                <use href={`#home-icon-${portal.icon}`}></use>
              </svg>
            </a>
          ))
        }
      </nav>

      <svg class="home-symbols" aria-hidden="true">
        <symbol id="home-icon-about" viewBox="0 0 96 96">
          <path d="M18 20h45a15 15 0 0 1 15 15v41H33a15 15 0 0 1-15-15V20Z"></path>
          <path d="M34 36h30M34 50h30M34 64h18"></path>
        </symbol>
        <symbol id="home-icon-members" viewBox="0 0 96 96">
          <circle cx="48" cy="31" r="13"></circle>
          <circle cx="22" cy="42" r="9"></circle>
          <circle cx="74" cy="42" r="9"></circle>
          <path d="M24 78c1-16 10-25 24-25s23 9 24 25M7 76c1-11 6-18 16-18M89 76c-1-11-6-18-16-18"></path>
        </symbol>
        <symbol id="home-icon-honors" viewBox="0 0 96 96">
          <path d="M31 16h34v16c0 17-8 27-17 27S31 49 31 32V16Z"></path>
          <path d="M31 23H17v8c0 12 7 19 19 19M65 23h14v8c0 12-7 19-19 19M48 59v12M32 80h32M39 71h18"></path>
        </symbol>
        <symbol id="home-icon-join" viewBox="0 0 96 96">
          <circle cx="48" cy="48" r="31"></circle>
          <path d="M33 48h30M53 38l10 10-10 10"></path>
          <path d="M48 7v10M48 79v10M7 48h10M79 48h10"></path>
        </symbol>
      </svg>

      <section class="home-updates" aria-labelledby="latest-title" data-reveal>
        <header class="home-updates__heading">
          <div>
            <p>RECENT / 最近更新</p>
            <h2 id="latest-title">团队记录</h2>
          </div>
          <a href="/articles/">全部文章 <span aria-hidden="true">→</span></a>
        </header>
        <div class="home-updates__list">
          {
            articles.map((article) => (
              <a href={`/articles/${article.id}/`}>
                <span>
                  <time datetime={article.data.publishedAt.toISOString()}>
                    {formatDate(article.data.publishedAt)}
                  </time>
                  <small>{article.data.category}</small>
                </span>
                <strong>{article.data.title}</strong>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
