---
import { getCollection, getEntry } from 'astro:content';
import RecruitmentContact from '../components/RecruitmentContact.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const recruitmentEntry = await getEntry('recruitment', 'main');
const siteEntry = await getEntry('siteSettings', 'main');
if (!recruitmentEntry || !siteEntry) throw new Error('缺少纳新或站点配置');

const recruitment = recruitmentEntry.data;
const site = siteEntry.data;
const interviewArticles = (await getCollection('articles'))
  .filter((article) => !article.data.draft && /^sec-interview-\d{4}$/.test(article.id))
  .map((article) => ({
    id: article.id,
    year: Number(article.id.slice(-4)),
  }))
  .sort((a, b) => b.year - a.year);

const interviewSteps = [
  {
    title: '第一次面试：基础能力',
    description:
      '主要了解 C 语言和计算机基础，包括代码阅读、编程思路和表达能力。不会的题目可以直接说明，清楚讲出已经想到哪里更重要。',
  },
  {
    title: '第二次面试：快速学习',
    description:
      '主要观察接触陌生内容后的学习过程。具体任务和准备时间会随当届通知说明，参加时需要携带自己的电脑。',
  },
  {
    title: '第三次面试：最终交流',
    description:
      '与通过前两轮的同学进一步交流，了解性格、学习方向、时间投入，以及对未来成长的期待。',
  },
];

const faqItems = [
  {
    question: '智邮普创是什么？',
    answer:
      '智邮普创工作室是信息中心下属的学生技术实验室，位于长安校区西区图书馆五楼。工作室参与数字校园建设与维护，也持续开展网络安全学习和竞赛实践。',
  },
  {
    question: '我怎样才能加入智邮普创？',
    answer:
      '关注公众号“智邮普创实验室”，并加入 QQ 群 1057111048。安全组通过三次面试了解基础、学习能力和个人方向；开发组为新增方向，具体安排以公众号和 QQ 群通知为准。',
  },
  {
    question: '现在应该从哪里开始准备？',
    answer:
      '先学习 C 语言和计算机基础，再接触常用 Linux 命令与虚拟机。比起赶进度，更重要的是理解每个问题，记录自己的尝试过程，并学会提出具体、有上下文的问题。',
  },
  {
    question: 'CTF 和新生赛是什么？',
    answer:
      'CTF 是通过解题获取 flag 的网络安全竞赛，常见方向包括 Web、Reverse、Pwn、Crypto 和 Misc。新生赛帮助刚入门的同学认识方向、体验比赛，也是了解学习成果的参考之一。',
  },
  {
    question: '第一次面试会不会很难？',
    answer:
      '题目会有一定区分度，但不要求每个人完成全部内容。我们更关注分析问题、表达思路和继续尝试的过程，认真完成自己能做到的部分即可。',
  },
  {
    question: '加入工作室能获得什么？',
    answer:
      '你会遇到愿意一起学习的同伴和可以交流的学长学姐，也有机会接触真实项目、安全研究和竞赛协作。工作室提供学习环境与实践机会，真正的成长仍然来自持续投入。',
  },
  {
    question: '参加第一次面试需要准备什么？',
    answer:
      '请携带可以正常编程的电脑，并提前整理自己想询问的问题。纸质简历可以自愿准备，方便介绍经历和兴趣，但不作强制要求。',
  },
];
---

<BaseLayout
  title="加入我们"
  description="智邮普创工作室加入说明、安全组面试流程、准备建议与长期联系方式。"
>
  <article class="join-document" aria-labelledby="join-title">
    <header class="join-header">
      <p class="join-kicker">JOIN / 加入我们</p>
      <h1 id="join-title">加入智邮普创</h1>
      <p class="join-lead">
        智邮普创面向全校大一新生，不限学院和专业。你不需要在加入前已经很强，我们更看重主动学习、认真思考和持续投入。
      </p>
      <ul class="join-summary">
        <li>信息中心下属学生技术实验室</li>
        <li>参与数字校园实践与网络安全研究</li>
        <li>公益免费，不收取培训费用</li>
      </ul>
    </header>

    <nav class="join-nav" aria-label="页面目录">
      <a href="#contact">联系方式</a>
      <a href="#directions">加入方向</a>
      <a href="#process">安全组流程</a>
      <a href="#interview-papers">历年一面题目</a>
      <a href="#preparation">如何准备</a>
      <a href="#faq">常见问题</a>
    </nav>

    <section id="contact" aria-labelledby="contact-title">
      <h2 id="contact-title">联系方式</h2>
      <p>具体场次和安排以公众号与纳新交流群通知为准。</p>
      <RecruitmentContact
        qqGroup={recruitment.qqGroup}
        wechatAccount={recruitment.wechatAccount}
        variant="full"
      />
      <div class="contact-location">
        <strong>线下地点</strong>
        <span>{site.location}</span>
      </div>
    </section>

    <section id="directions" aria-labelledby="directions-title">
      <h2 id="directions-title">加入方向</h2>

      <h3>安全组</h3>
      <p>
        围绕 Web 安全、二进制安全、逆向工程、密码学和电子取证等方向学习，通过 CTF、新生赛、日常训练与复盘逐步建立安全能力。
      </p>

      <h3>开发组</h3>
      <p>
        开发组是本届新增方向，具体技术方向、培养内容和选拔方式仍在确认中。请以公众号“智邮普创实验室”和纳新交流群发布的信息为准。
      </p>
    </section>

    <section id="process" aria-labelledby="process-title">
      <h2 id="process-title">安全组加入流程</h2>
      <p>安全组通常包含三次面试，具体题目、场次和准备时间以当届通知为准。</p>
      <ol class="process-list">
        {
          interviewSteps.map((step) => (
            <li>
              <strong>{step.title}</strong>
              <p>{step.description}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="interview-papers" aria-labelledby="interview-papers-title">
      <h2 id="interview-papers-title">历年一面题目</h2>
      <p>以下题目来自工作室往届安全组第一次面试，可用于了解考查范围和题目形式。</p>
      <ul class="interview-paper-list">
        {
          interviewArticles.map((article) => (
            <li class="interview-paper-entry">
              <a
                class="interview-paper-year"
                href={`/articles/${article.id}/`}
                aria-label={`${article.year} 年面试题`}
              >
                {article.year}
              </a>
              <a class="interview-paper-article" href={`/articles/${article.id}/`}>
                <strong class="interview-paper-title">
                  智邮普创工作室 SEC 组 {article.year} 年第一次面试题
                </strong>
              </a>
              <a
                class="interview-paper-download"
                href={`/downloads/interviews/zypc-sec-interview-${article.year}.pdf`}
                download={`智邮普创工作室-SEC组-${article.year}年第一次面试题.pdf`}
              >
                PDF 下载 <span aria-hidden="true">↓</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="preparation" aria-labelledby="preparation-title">
      <h2 id="preparation-title">如何准备</h2>
      <ul>
        <li><strong>C 语言：</strong>理解变量、流程控制、函数、指针和基础数据结构，可以参考《C Primer Plus》。</li>
        <li><strong>计算机基础：</strong>熟悉常用 Linux 命令，尝试在虚拟机中安装和使用 Linux。</li>
        <li><strong>思考习惯：</strong>遇到问题先查资料、动手验证，再整理自己尝试过的方法。</li>
        <li><strong>提问能力：</strong>说明问题背景、预期结果和已经做过的尝试，推荐阅读《提问的智慧》。</li>
      </ul>

      <h3>第一次面试前</h3>
      <ul>
        <li>携带可以正常编程的电脑。</li>
        <li>整理自己真正想问的问题。</li>
        <li>纸质简历可以携带，但不作强制要求。</li>
        <li>不会的题目不必硬猜，清楚说明自己的思考过程。</li>
      </ul>
    </section>

    <section aria-labelledby="ctf-title">
      <h2 id="ctf-title">关于 CTF 与新生赛</h2>
      <p>
        CTF 是通过解决网络安全题目获取 flag 的竞赛。新生赛面向基础阶段的同学，目的是帮助大家认识不同安全方向、体验比赛，并检验一段时间的学习成果。
      </p>
      <p>
        比赛成绩会作为参考，但不是唯一标准。我们同样关注思考过程、学习态度、持续投入和交流表达。
      </p>
    </section>

    <section id="faq" aria-labelledby="faq-title">
      <h2 id="faq-title">常见问题</h2>
      <ul class="faq-list">
        {
          faqItems.map((item) => (
            <li>
              <strong>{item.question}</strong>
              <p>{item.answer}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .join-document {
    width: min(calc(100% - 2rem), 68rem);
    padding: 7.5rem 0 6rem;
    margin: 0 auto;
    color: var(--ink);
  }

  .join-header {
    max-width: 64rem;
  }

  .join-kicker {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--blue-700);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .join-kicker::before {
    width: 1.45rem;
    height: 1px;
    background: currentColor;
    content: '';
  }

  .join-header h1 {
    margin-top: 0.75rem;
    font-size: clamp(1.8rem, 2.5vw, 2rem);
    font-weight: 680;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  .join-lead {
    margin-top: 1rem;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .join-summary {
    margin-top: 1.25rem;
  }

  .join-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.35rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-top: 2.25rem;
  }

  .join-nav a {
    color: var(--muted);
    font-size: var(--text-small);
    text-decoration: none;
  }

  .join-nav a::before {
    color: var(--blue);
    content: '# ';
  }

  .join-nav a:hover,
  .join-nav a:focus-visible {
    color: var(--blue-700);
  }

  section {
    scroll-margin-top: 6rem;
    margin-top: 3.4rem;
  }

  section h2 {
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--line);
    font-size: clamp(1.35rem, 2.4vw, 1.65rem);
    font-weight: 680;
    letter-spacing: -0.02em;
    line-height: 1.35;
  }

  section h3 {
    margin-top: 1.75rem;
    font-size: 1.08rem;
    font-weight: 680;
  }

  section > p,
  section li p {
    margin-top: 0.8rem;
    color: var(--ink-soft);
    line-height: 1.85;
  }

  section ul,
  section ol {
    padding-left: 1.4rem;
    margin-top: 1rem;
  }

  section li {
    padding-left: 0.2rem;
    margin-top: 0.65rem;
    color: var(--ink-soft);
    line-height: 1.8;
  }

  section li::marker {
    color: var(--blue);
  }

  section li strong {
    color: var(--ink);
    font-weight: 680;
  }

  .contact-location {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }

  .contact-location strong {
    font-size: var(--text-small);
  }

  .contact-location span {
    color: var(--ink-soft);
  }

  .process-list li + li {
    margin-top: 1rem;
  }

  .process-list li p {
    margin-top: 0.25rem;
  }

  .interview-paper-list {
    padding: 0;
    border-top: 1px solid var(--line);
    margin-top: 1rem;
    list-style: none;
  }

  .interview-paper-list .interview-paper-entry {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.15rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
    margin: 0;
  }

  .interview-paper-year {
    justify-self: start;
    width: fit-content;
    color: var(--blue-700);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .interview-paper-title {
    min-width: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    transition: color 160ms ease;
  }

  .interview-paper-article {
    justify-self: start;
    width: fit-content;
    max-width: 100%;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .interview-paper-year:hover,
  .interview-paper-year:focus-visible,
  .interview-paper-article:hover .interview-paper-title,
  .interview-paper-article:focus-visible .interview-paper-title {
    color: var(--blue-700);
  }

  .interview-paper-download {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: 2rem;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 0.45rem;
    background: var(--surface-subtle);
    color: var(--ink-soft);
    font-size: 0.78rem;
    line-height: 1;
    text-decoration: none;
  }

  .interview-paper-download:hover,
  .interview-paper-download:focus-visible {
    border-color: var(--blue);
    background: var(--blue-100);
    color: var(--blue-700);
  }

  .interview-paper-download span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .faq-list {
    list-style: disc;
  }

  .faq-list li {
    margin-top: 1.15rem;
  }

  .faq-list li p {
    margin-top: 0.25rem;
  }

  @media (max-width: 600px) {
    .join-document {
      width: min(calc(100% - 1.5rem), 68rem);
      padding-top: 6.25rem;
      padding-bottom: 4rem;
    }

    .join-header h1 {
      font-size: 1.8rem;
    }

    .join-lead {
      font-size: 1rem;
    }

    section {
      margin-top: 2.8rem;
    }

    .contact-location {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }

    .interview-paper-list .interview-paper-entry {
      grid-template-columns: 3.25rem minmax(0, 1fr);
      align-items: flex-start;
      gap: 0.35rem 0.75rem;
    }

    .interview-paper-title {
      font-size: 0.92rem;
    }

    .interview-paper-download {
      grid-column: 2;
      justify-self: start;
      margin-top: 0.25rem;
    }
  }
</style>
