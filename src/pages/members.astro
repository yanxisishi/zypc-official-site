---
import BaseLayout from '../layouts/BaseLayout.astro';
import memberGroups from '../data/members';

const cohortGroups = memberGroups.map((group, index) => ({
  ...group,
  id: `cohort-${group.cohort.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`,
  label: /^\d{4}$/.test(group.cohort) ? `${group.cohort} 届` : group.cohort,
  width: `${Math.min(80 + index * 5, 100)}%`,
}));

const firstCohort = cohortGroups.at(0)?.cohort ?? '';
const latestCohort = cohortGroups.at(-1)?.cohort ?? '';

const getLinkHost = (link?: string) => {
  if (!link) return '';
  try {
    return new URL(link).hostname.replace(/^www\./, '');
  } catch {
    return link;
  }
};

const getGithubName = (github?: string) => {
  if (!github) return '';
  try {
    return new URL(github).pathname.split('/').filter(Boolean)[0] ?? '';
  } catch {
    return github.replace(/^@/, '').replace(/^github\.com\//, '').split('/')[0];
  }
};

const getGithubUrl = (github?: string) => {
  const name = getGithubName(github);
  return name ? `https://github.com/${name}` : undefined;
};
---

<BaseLayout
  title="团队成员"
  description={`按加入年份认识智邮普创工作室 ${firstCohort} 至 ${latestCohort} 届成员。`}
>
  <main class="members-page" aria-labelledby="members-title">
    <div class="shell">
      <header class="members-masthead">
        <span class="members-masthead__backdrop" aria-hidden="true">ZYPC</span>
        <p>PEOPLE / {firstCohort}—{latestCohort}</p>
        <h1 id="members-title">智邮普创成员名录</h1>
      </header>

      <div class="cohort-directory">
        {
          cohortGroups.map((group) => (
            <section
              class="cohort-group"
              id={group.id}
              style={`--pyramid-width: ${group.width}`}
              aria-labelledby={`${group.id}-title`}
            >
              <header class="cohort-heading">
                <h2 id={`${group.id}-title`}>{group.label}</h2>
                <p>{group.desc}</p>
              </header>

              {
                group.entries.length > 0 ? (
                  <menu class="member-list" aria-label={`${group.label}成员`}>
                    {
                      group.entries.map((member, index) => {
                        const displayName = member.nickname;
                        const detailId = `member-${group.cohort}-${index + 1}-detail`;
                        const githubName = getGithubName(member.github);
                        const githubUrl = getGithubUrl(member.github);
                        const resolvedAvatar =
                          member.avatar ??
                          (member.qq
                            ? `https://q1.qlogo.cn/g?b=qq&nk=${encodeURIComponent(member.qq)}&s=640`
                            : githubName
                              ? `https://github.com/${githubName}.png?size=160`
                              : undefined);
                        const primaryLink = member.blog ?? githubUrl;
                        const primaryHost = getLinkHost(primaryLink);

                        return (
                          <li class="member-entry" data-member-entry>
                            <button
                              class="member-card"
                              type="button"
                              aria-expanded="false"
                              aria-controls={detailId}
                              data-member-trigger
                            >
                              <span class="member-card__avatar" aria-hidden="true">
                                {resolvedAvatar ? (
                                  <img
                                    src={resolvedAvatar}
                                    alt=""
                                    width="80"
                                    height="80"
                                    loading="lazy"
                                  />
                                ) : (
                                  <span>{member.nickname.slice(0, 1).toUpperCase()}</span>
                                )}
                              </span>
                              <span class="member-card__identity">
                                <span class="member-card__name">{displayName}</span>
                                {member.sitenick && (
                                  <span class="member-card__sitenick">{member.sitenick}</span>
                                )}
                              </span>
                            </button>

                            <aside
                              class="member-tooltip"
                              id={detailId}
                              aria-label={`${displayName}的公开资料`}
                            >
                              <div class="member-tooltip__site">
                                <span class="member-tooltip__avatar" aria-hidden="true">
                                  {resolvedAvatar ? (
                                    <img src={resolvedAvatar} alt="" width="64" height="64" loading="lazy" />
                                  ) : (
                                    <span>{member.nickname.slice(0, 1).toUpperCase()}</span>
                                  )}
                                </span>

                                <div class="member-tooltip__identity">
                                  <strong>{member.title ?? displayName}</strong>
                                  {primaryLink ? (
                                    <a href={primaryLink} target="_blank" rel="noreferrer">
                                      <span>{primaryHost}</span><i aria-hidden="true">▲</i>
                                    </a>
                                  ) : (
                                    <span>暂无公开主页</span>
                                  )}
                                </div>
                              </div>

                              <div class="member-tooltip__desc">
                                <span class="member-tooltip__year" aria-hidden="true">{group.cohort}</span>
                                <div class="member-tooltip__contacts" aria-label="公开联系方式">
                                  {member.qq && (
                                    <div class="member-tooltip__contact">
                                      <span class="member-tooltip__brand member-tooltip__brand--qq" title="QQ">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                          <path d="m17.536 12.514-.696-1.796c0-.021.01-.375.01-.558C16.85 7.088 15.447 4 12 4s-4.848 3.088-4.848 6.16c0 .183.009.537.01.557l-.696 1.797c-.19.515-.38 1.05-.517 1.51-.657 2.189-.444 3.095-.282 3.115.348.043 1.354-1.648 1.354-1.648 0 .98.487 2.258 1.542 3.18-.394.127-.878.32-1.188.557-.28.214-.245.431-.194.52.22.385 3.79.245 4.82.125 1.03.12 4.599.26 4.82-.126.05-.088.085-.305-.194-.519-.311-.237-.795-.43-1.19-.556 1.055-.923 1.542-2.202 1.542-3.181 0 0 1.007 1.691 1.355 1.648.162-.02.378-.928-.283-3.116a27 27 0 0 0-.516-1.509m1.021 8.227c-.373.652-.833.892-1.438 1.057a5 5 0 0 1-.794.138c-.44.045-.986.065-1.613.064a33 33 0 0 1-2.71-.116c-.692.065-1.785.114-2.71.116a16 16 0 0 1-1.614-.064 5 5 0 0 1-.793-.138c-.605-.164-1.065-.405-1.44-1.059a2.27 2.27 0 0 1-.239-1.652c-.592-.132-1.001-.482-1.279-.911a2.4 2.4 0 0 1-.309-.71 4 4 0 0 1-.116-1.106c.013-.785.187-1.762.532-2.912.14-.466.327-1.008.567-1.655l.554-1.43-.002-.203C5.153 5.605 7.589 2 12 2c4.413 0 6.848 3.605 6.848 8.16l-.001.203.553 1.43.01.026c.225.606.413 1.153.556 1.626.348 1.15.522 2.128.535 2.916q.012.61-.118 1.108c-.066.246-.161.48-.31.708-.276.427-.684.776-1.277.91.13.554.055 1.14-.24 1.654" />
                                        </svg>
                                        <span class="sr-only">QQ</span>
                                      </span>
                                      <span class="member-tooltip__value">{member.qq}</span>
                                      <button
                                        class="member-tooltip__copy"
                                        type="button"
                                        title={`复制 QQ：${member.qq}`}
                                        aria-label={`复制 QQ 号 ${member.qq}`}
                                        data-copy-contact={member.qq}
                                        data-copy-name="QQ 号"
                                      >
                                        <svg class="member-tooltip__copy-icon" viewBox="0 0 24 24" aria-hidden="true">
                                          <rect x="8" y="8" width="11" height="11" rx="2"></rect>
                                          <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
                                        </svg>
                                        <svg class="member-tooltip__check-icon" viewBox="0 0 24 24" aria-hidden="true">
                                          <path d="m5 12 4 4L19 6"></path>
                                        </svg>
                                      </button>
                                    </div>
                                  )}
                                  {githubName && githubUrl && (
                                    <div class="member-tooltip__contact">
                                      <span class="member-tooltip__brand member-tooltip__brand--github" title="GitHub">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                          <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
                                        </svg>
                                        <span class="sr-only">GitHub</span>
                                      </span>
                                      <a
                                        class="member-tooltip__value"
                                        href={githubUrl}
                                        target="_blank"
                                        rel="noreferrer"
                                      >
                                        {githubName}
                                      </a>
                                      <button
                                        class="member-tooltip__copy"
                                        type="button"
                                        title={`复制 GitHub 主页：${githubUrl}`}
                                        aria-label={`复制 GitHub 主页 ${githubUrl}`}
                                        data-copy-contact={githubUrl}
                                        data-copy-name="GitHub 主页"
                                      >
                                        <svg class="member-tooltip__copy-icon" viewBox="0 0 24 24" aria-hidden="true">
                                          <rect x="8" y="8" width="11" height="11" rx="2"></rect>
                                          <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
                                        </svg>
                                        <svg class="member-tooltip__check-icon" viewBox="0 0 24 24" aria-hidden="true">
                                          <path d="m5 12 4 4L19 6"></path>
                                        </svg>
                                      </button>
                                    </div>
                                  )}
                                  {!member.qq && !member.github && (
                                    <span>暂无公开联系方式</span>
                                  )}
                                </div>
                              </div>
                            </aside>
                          </li>
                        );
                      })
                    }
                  </menu>
                ) : (
                  <p class="cohort-empty">成员资料整理中</p>
                )
              }
            </section>
          ))
        }
      </div>
    </div>
  </main>

  <script>
    const entries = [...document.querySelectorAll<HTMLElement>('[data-member-entry]')];
    const contactCopyButtons = [
      ...document.querySelectorAll<HTMLButtonElement>('[data-copy-contact]'),
    ];
    const mobileMembersQuery = window.matchMedia('(max-width: 680px)');
    const supportsPopover = 'showPopover' in HTMLElement.prototype;
    const placementPreference = ['bottom', 'top', 'right', 'left'] as const;
    type TooltipPlacement = (typeof placementPreference)[number];
    let placementFrame = 0;
    let openEntry: HTMLElement | null = null;
    let desktopActiveEntry: HTMLElement | null = null;

    const getEntryTrigger = (entry: HTMLElement) =>
      entry.querySelector<HTMLButtonElement>('[data-member-trigger]');

    const getEntryDetail = (entry: HTMLElement) => {
      const detailId = getEntryTrigger(entry)?.getAttribute('aria-controls');
      return detailId ? document.getElementById(detailId) : null;
    };

    const setDesktopEntryActive = (entry: HTMLElement | null) => {
      if (desktopActiveEntry === entry) return;
      desktopActiveEntry?.classList.remove('is-desktop-active');
      desktopActiveEntry = entry;
      desktopActiveEntry?.classList.add('is-desktop-active');
    };

    const entryHasVisibleFocus = (entry: HTMLElement) => {
      const activeElement = document.activeElement;
      return (
        activeElement instanceof HTMLElement &&
        entry.contains(activeElement) &&
        activeElement.matches(':focus-visible')
      );
    };

    const resetDetailPlacement = (detail: HTMLElement) => {
      detail.style.removeProperty('--member-popover-left');
      detail.style.removeProperty('--member-popover-top');
      delete detail.dataset.placement;
    };

    const deactivateMobileDetail = (entry: HTMLElement) => {
      const detail = getEntryDetail(entry);
      if (!detail) return;

      if (supportsPopover && detail.matches(':popover-open')) {
        detail.hidePopover();
      }
      detail.removeAttribute('popover');
      detail.classList.remove('is-mobile-popover-open');
      resetDetailPlacement(detail);

      if (detail.dataset.portalFallback === 'true') {
        entry.append(detail);
        delete detail.dataset.portalFallback;
      }
    };

    const activateMobileDetail = (entry: HTMLElement) => {
      const detail = getEntryDetail(entry);
      if (!detail || !mobileMembersQuery.matches) return;

      resetDetailPlacement(detail);
      let shownInTopLayer = false;

      if (supportsPopover) {
        try {
          detail.setAttribute('popover', 'manual');
          detail.showPopover();
          shownInTopLayer = true;
        } catch {
          detail.removeAttribute('popover');
        }
      }

      if (!shownInTopLayer) {
        document.body.append(detail);
        detail.dataset.portalFallback = 'true';
        detail.classList.add('is-mobile-popover-open');
      }
    };

    const setEntryOpen = (entry: HTMLElement, open: boolean) => {
      entry.classList.toggle('is-open', open);
      getEntryTrigger(entry)?.setAttribute('aria-expanded', String(open));

      if (!open) {
        deactivateMobileDetail(entry);
        if (openEntry === entry) openEntry = null;
        return;
      }

      openEntry = entry;
      if (mobileMembersQuery.matches) activateMobileDetail(entry);
      requestOpenEntryPlacement();
    };

    const positionEntryTooltip = (entry: HTMLElement) => {
      if (!entry.classList.contains('is-open') || !mobileMembersQuery.matches) return;

      const trigger = getEntryTrigger(entry);
      const detail = getEntryDetail(entry);
      if (!trigger || !detail) return;

      const visualViewport = window.visualViewport;
      const viewportLeft = visualViewport?.offsetLeft ?? 0;
      const viewportTop = visualViewport?.offsetTop ?? 0;
      const viewportRight = viewportLeft + (visualViewport?.width ?? window.innerWidth);
      const viewportBottom = viewportTop + (visualViewport?.height ?? window.innerHeight);
      const headerBottom =
        document.querySelector<HTMLElement>('.site-header')?.getBoundingClientRect().bottom ?? 0;
      const safeLeft = viewportLeft + 12;
      const safeTop = Math.max(viewportTop + 12, headerBottom + 8);
      const safeRight = viewportRight - 12;
      const safeBottom = viewportBottom - 12;
      const gap = 8;
      const triggerRect = trigger.getBoundingClientRect();

      const triggerOutsideViewport =
        triggerRect.bottom <= safeTop ||
        triggerRect.top >= safeBottom ||
        triggerRect.right <= safeLeft ||
        triggerRect.left >= safeRight;
      if (triggerOutsideViewport) {
        setEntryOpen(entry, false);
        return;
      }

      const detailRect = detail.getBoundingClientRect();
      const spaces: Record<TooltipPlacement, number> = {
        bottom: safeBottom - triggerRect.bottom - gap,
        top: triggerRect.top - safeTop - gap,
        right: safeRight - triggerRect.right - gap,
        left: triggerRect.left - safeLeft - gap,
      };
      const requiredSpace: Record<TooltipPlacement, number> = {
        bottom: detailRect.height,
        top: detailRect.height,
        right: detailRect.width,
        left: detailRect.width,
      };
      const placement = [...placementPreference].sort((first, second) => {
        const firstFits = spaces[first] >= requiredSpace[first];
        const secondFits = spaces[second] >= requiredSpace[second];
        if (firstFits !== secondFits) return firstFits ? -1 : 1;

        const firstScore = spaces[first] / Math.max(requiredSpace[first], 1);
        const secondScore = spaces[second] / Math.max(requiredSpace[second], 1);
        return secondScore - firstScore;
      })[0];

      let rawLeft = triggerRect.left + (triggerRect.width - detailRect.width) / 2;
      let rawTop = triggerRect.bottom + gap;
      if (placement === 'top') rawTop = triggerRect.top - detailRect.height - gap;
      if (placement === 'right') {
        rawLeft = triggerRect.right + gap;
        rawTop = triggerRect.top + (triggerRect.height - detailRect.height) / 2;
      }
      if (placement === 'left') {
        rawLeft = triggerRect.left - detailRect.width - gap;
        rawTop = triggerRect.top + (triggerRect.height - detailRect.height) / 2;
      }

      const maxLeft = Math.max(safeLeft, safeRight - detailRect.width);
      const maxTop = Math.max(safeTop, safeBottom - detailRect.height);
      const left = Math.min(maxLeft, Math.max(safeLeft, rawLeft));
      const top = Math.min(maxTop, Math.max(safeTop, rawTop));

      detail.dataset.placement = placement;
      detail.style.setProperty('--member-popover-left', `${left}px`);
      detail.style.setProperty('--member-popover-top', `${top}px`);
    };

    function requestOpenEntryPlacement() {
      window.cancelAnimationFrame(placementFrame);
      placementFrame = window.requestAnimationFrame(() => {
        placementFrame = 0;
        if (openEntry) positionEntryTooltip(openEntry);
      });
    }

    const syncOpenEntryPresentation = () => {
      if (mobileMembersQuery.matches) {
        setDesktopEntryActive(null);
        if (!openEntry) return;
        activateMobileDetail(openEntry);
        requestOpenEntryPlacement();
        return;
      }

      if (openEntry) setEntryOpen(openEntry, false);
    };

    const closeEntries = (except?: HTMLElement) => {
      entries.forEach((entry) => {
        if (entry !== except) setEntryOpen(entry, false);
      });
    };

    entries.forEach((entry) => {
      entry.addEventListener('pointerenter', () => {
        if (!mobileMembersQuery.matches) setDesktopEntryActive(entry);
      });

      entry.addEventListener('pointerleave', () => {
        if (
          !mobileMembersQuery.matches &&
          desktopActiveEntry === entry &&
          !entryHasVisibleFocus(entry)
        ) {
          setDesktopEntryActive(null);
        }
      });

      entry.addEventListener('focusin', () => {
        if (mobileMembersQuery.matches) return;
        window.requestAnimationFrame(() => {
          if (entryHasVisibleFocus(entry)) setDesktopEntryActive(entry);
        });
      });

      entry.addEventListener('focusout', (event) => {
        if (mobileMembersQuery.matches) return;
        const nextTarget = event.relatedTarget;
        if (nextTarget instanceof Node && entry.contains(nextTarget)) return;

        window.requestAnimationFrame(() => {
          if (
            desktopActiveEntry === entry &&
            !entry.matches(':hover') &&
            !entryHasVisibleFocus(entry)
          ) {
            setDesktopEntryActive(null);
          }
        });
      });

      entry.querySelector<HTMLButtonElement>('[data-member-trigger]')
        ?.addEventListener('click', () => {
          if (!mobileMembersQuery.matches) return;
          const nextOpen = !entry.classList.contains('is-open');
          closeEntries(entry);
          setEntryOpen(entry, nextOpen);
        });
    });

    const copyText = async (value: string) => {
      if (navigator.clipboard?.writeText) {
        try {
          await navigator.clipboard.writeText(value);
          return true;
        } catch {
          // Fall through for HTTP deployments and denied clipboard permissions.
        }
      }

      const helper = document.createElement('textarea');
      helper.value = value;
      helper.setAttribute('readonly', '');
      Object.assign(helper.style, {
        position: 'fixed',
        inset: '0',
        opacity: '0',
        pointerEvents: 'none',
      });
      document.body.append(helper);
      helper.select();
      helper.setSelectionRange(0, value.length);

      try {
        const legacyCopy = Reflect.get(document, 'execCommand');
        return typeof legacyCopy === 'function' && legacyCopy.call(document, 'copy');
      } catch {
        return false;
      } finally {
        helper.remove();
      }
    };

    contactCopyButtons.forEach((button) => {
      button.addEventListener('click', async () => {
        const value = button.dataset.copyContact;
        const name = button.dataset.copyName ?? '内容';
        if (!value) return;

        const copied = await copyText(value);
        if (copied) {
          button.classList.add('is-copied');
          button.setAttribute('aria-label', `已复制${name} ${value}`);
          window.setTimeout(() => {
            button.classList.remove('is-copied');
            button.setAttribute('aria-label', `复制${name} ${value}`);
          }, 1600);
        } else {
          button.setAttribute('aria-label', `${name} ${value}`);
        }
      });
    });

    document.addEventListener('click', (event) => {
      const target = event.target as Element;
      const openDetail = openEntry ? getEntryDetail(openEntry) : null;
      if (!target.closest('[data-member-entry]') && !openDetail?.contains(target)) closeEntries();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (!openEntry) return;
      const entryToClose = openEntry;
      setEntryOpen(entryToClose, false);
      getEntryTrigger(entryToClose)?.focus();
    });

    window.addEventListener('scroll', requestOpenEntryPlacement, { passive: true });
    window.addEventListener('resize', requestOpenEntryPlacement);
    window.visualViewport?.addEventListener('scroll', requestOpenEntryPlacement);
    window.visualViewport?.addEventListener('resize', requestOpenEntryPlacement);
    mobileMembersQuery.addEventListener('change', syncOpenEntryPresentation);
  </script>
</BaseLayout>

<style>
  .members-page {
    overflow: clip;
    min-height: 100vh;
    padding: 6.5rem 0 4rem;
    background:
      radial-gradient(circle at 50% 2%, rgba(88, 175, 229, 0.1), transparent 32rem),
      var(--paper);
  }

  .members-masthead {
    position: relative;
    display: grid;
    min-height: 10rem;
    justify-items: center;
    align-content: center;
    padding: 1.75rem 0 1.25rem;
    text-align: center;
  }

  .members-masthead__backdrop {
    position: absolute;
    top: 0;
    left: 50%;
    color: transparent;
    font-family: var(--font-mono);
    font-size: clamp(4.5rem, 8vw, 7rem);
    font-weight: 800;
    letter-spacing: -0.08em;
    line-height: 1;
    opacity: 0.48;
    pointer-events: none;
    transform: translateX(-50%);
    -webkit-text-stroke: 1px var(--line-strong);
  }

  .members-masthead > p {
    position: relative;
    color: var(--blue-700);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .members-masthead h1 {
    position: relative;
    margin-top: 0.4rem;
    font-size: clamp(1.875rem, 3vw, 2.25rem);
    font-weight: 680;
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  .cohort-directory {
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.75rem);
    margin-top: 0.75rem;
  }

  .cohort-group {
    position: relative;
    width: var(--pyramid-width);
    margin-inline: auto;
    scroll-margin-top: 6rem;
  }

  .cohort-heading {
    position: relative;
    display: grid;
    justify-items: center;
    min-height: 5.25rem;
    align-content: center;
    text-align: center;
  }

  .cohort-heading h2 {
    color: transparent;
    font-family: var(--font-mono);
    font-size: clamp(3.5rem, 5.4vw, 4.75rem);
    font-weight: 800;
    letter-spacing: -0.08em;
    line-height: 1;
    opacity: 0.58;
    transition: color 180ms ease;
    -webkit-text-stroke: 1px var(--line-strong);
  }

  .cohort-group:hover .cohort-heading h2 {
    color: var(--surface-card);
  }

  .cohort-heading p {
    position: relative;
    margin-top: -0.55rem;
    color: var(--ink-soft);
    font-size: 0.875rem;
  }

  .member-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    gap: 0.35rem;
    padding: 0;
    margin: 0.65rem auto 0;
    list-style: none;
  }

  .member-entry {
    position: relative;
    z-index: 1;
    width: fit-content;
    max-width: 14rem;
    flex: 0 1 auto;
    min-width: 0;
  }

  .member-entry.is-desktop-active,
  .member-entry.is-open {
    z-index: 40;
  }

  .member-card {
    display: flex;
    width: max-content;
    max-width: 100%;
    min-height: 3.5rem;
    align-items: center;
    gap: 0.5rem;
